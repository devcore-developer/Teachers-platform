# ======================================================================
# Manarat Qurtubah Platform — Environment Variables (Phase 11 additions)
# ----------------------------------------------------------------------
# Copy the relevant values into your real .env (never commit real secrets).
# Without the email block the platform still runs fully: email delivery
# is reported honestly as "not configured" (see /integrations).
# ======================================================================

# --- Database (existing) ------------------------------------------------
DATABASE_URL=file:./prisma/dev.db

# --- Transactional email (Phase 11 — provider: Resend HTTP API) --------
# Get an API key from your Resend account dashboard.
RESEND_API_KEY=
# Verified sender, e.g. "Manarat Platform <no-reply@your-domain.tld>"
# (the domain must be verified in Resend).
EMAIL_FROM=
# Optional reply-to address.
EMAIL_REPLY_TO=

# --- Scheduled jobs (Phase 11) ------------------------------------------
# Shared secret for POST|GET /api/cron/dispatch (external scheduler calls
# it with header "x-cron-secret: <value>" or "Authorization: Bearer <value>").
# Leave unset to keep the endpoint disabled (it responds 503).
CRON_SECRET=

# Absolute public origin used to build links inside outbound emails,
# e.g. https://platform.manarat.example — no trailing slash.
APP_PUBLIC_ORIGIN=

# OPTIONAL fallback scheduler inside the Node process (default: false).
# Prefer an external scheduler hitting /api/cron/dispatch; only enable
# this for single-instance deployments that cannot run one.
ENABLE_INTERNAL_SCHEDULER=false

# --- Submission file storage (Phase 12 docs) ---------------------------
# Absolute directory for uploaded assignment attachments. Default when
# unset: <project>/.data/assignment-files. Files are served ONLY through
# the authorized /api/assignment-files/[id] endpoint.
ASSIGNMENTS_STORAGE_DIR=

# --- Survey pre/post linking pepper (Phase 12) --------------------------
# Long random string used to pseudonymize anonymous-but-linked survey
# responses. SHOULD be set in production. WARNING: changing it AFTER
# linked anonymous responses exist breaks pre/post pairing — set it once
# at first deployment and keep it stable. Leave unset to use the
# built-in fallback (a one-time warning appears in production).
SURVEY_LINK_PEPPER=